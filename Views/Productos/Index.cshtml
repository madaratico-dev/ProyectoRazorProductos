@model IEnumerable<ProyectoRazorProductos.Models.Producto>

@{
    ViewData["Title"] = "Productos";
    string buscar = ViewData["Buscar"]?.ToString() ?? "";
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a asp-controller="Home" asp-action="Index">Inicio</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">
            Productos
        </li>
    </ol>
</nav>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">

    <div>
        <h1 class="mb-1">Productos</h1>
        <p class="text-body-secondary mb-0">
            Administración del catálogo almacenado en SQL Server.
        </p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        Nuevo producto
    </a>

</div>

@if (!string.IsNullOrWhiteSpace(buscar))
{
    <div class="alert alert-info d-flex justify-content-between align-items-center">

        <span>
            Resultados para <strong>@buscar</strong>:
            @Model.Count() producto(s).
        </span>

        <a asp-action="Index"
           class="btn btn-sm btn-outline-info">
            Limpiar
        </a>

    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-warning">
        No se encontraron productos con los criterios indicados.
    </div>
}
else
{
    <div class="table-responsive shadow-sm rounded">

        <table class="table table-striped table-hover align-middle mb-0">

            <thead class="table-dark">
                <tr>
                    <th>Nombre</th>
                    <th>Categoría</th>
                    <th class="text-end">Precio</th>
                    <th>Estado</th>
                    <th>Fecha</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <td class="fw-semibold">
                            @item.Nombre
                        </td>

                        <td>
                            @item.Categoria?.Nombre
                        </td>

                        <td class="text-end">
                            @item.Precio.ToString("C")
                        </td>

                        <td>
                            @if (item.Activo)
                            {
                                <span class="badge text-bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">Inactivo</span>
                            }
                        </td>

                        <td>
                            @item.FechaCreacion.ToShortDateString()
                        </td>

                        <td class="text-end">

                            <div class="btn-group btn-group-sm" role="group">

                                <a asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="btn btn-outline-primary">
                                    Ver
                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-outline-warning">
                                    Editar
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@item.Id"
                                   class="btn btn-outline-danger">
                                    Eliminar
                                </a>

                            </div>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>
}