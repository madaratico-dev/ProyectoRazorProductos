@model ProyectoRazorProductos.Models.Producto

@{
    ViewData["Title"] = "Detalle del producto";
}
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a asp-controller="Home" asp-action="Index">Inicio</a>
        </li>
        <li class="breadcrumb-item">
            <a asp-controller="Productos" asp-action="Index">
                Productos
            </a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">
            Detalle
        </li>
    </ol>
</nav>

<h1>Detalle del producto</h1>

<dl class="row">
    <dt class="col-sm-3">Nombre</dt>
    <dd class="col-sm-9">@Model.Nombre</dd>

    <dt class="col-sm-3">Precio</dt>
    <dd class="col-sm-9">@Model.Precio.ToString("C")</dd>

    <dt class="col-sm-3">Descripción</dt>
    <dd class="col-sm-9">@Model.Descripcion</dd>

    <dt class="col-sm-3">Categoría</dt>
    <dd class="col-sm-9">@Model.Categoria?.Nombre</dd>

    <dt class="col-sm-3">Activo</dt>
    <dd class="col-sm-9">@(Model.Activo ? "Sí" : "No")</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a>
<a asp-action="Index" class="btn btn-secondary">Volver</a>